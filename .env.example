# Database
DATABASE_URL=postgresql://username:password@localhost:5432/music_artist_website

# Payload CMS
PAYLOAD_SECRET=your-payload-secret-key-here
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# Next.js
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Optional: Cloudinary (for advanced media handling)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Email service (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password